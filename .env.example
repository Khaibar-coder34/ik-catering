# Publieke absolute URL, zonder afsluitende slash.
# Gebruik voor de eerste Netlify-test de werkelijke .netlify.app URL.
NEXT_PUBLIC_SITE_URL=https://catering.indiasekeuken.nl

# Servergeheim. Zet echte waarden alleen in .env.local of Netlify.
RESEND_API_KEY=
# Enkel e-mailadres op een in Resend geverifieerd domein; geen displaynaam.
RESEND_FROM_EMAIL=
# Optionele afwijkende ontvanger. Leeg gebruikt email uit src/data/site.json.
NOTIFICATION_TO_EMAIL=

# Samen configureren. Production blokkeert standaard zonder Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Bewuste uitzondering met zwakkere bescherming; aanbevolen false.
ALLOW_UNPROTECTED_FORMS=false

# Alleen lokale ontwikkeling. Production negeert deze schakelaar altijd.
CATALOG_DEMO=false
